<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Dev (profile "local"): consola humana legible, con color -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%-35.35logger{34}) - %msg%n%ex</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Prod (Railway / Render): JSON a stdout, capturado por la plataforma -->
    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <customFields>{"app":"viscosg","env":"${SPRING_PROFILES_ACTIVE:-prod}"}</customFields>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <level>level</level>
                    <logger>logger</logger>
                    <message>message</message>
                    <thread>thread</thread>
                    <mdc>mdc</mdc>
                </fieldNames>
            </encoder>
        </appender>
    </springProfile>

    <!-- Loki — solo se activa con el profile "loki" (requiere credenciales válidas).
         Railway captura stdout por defecto, así que Loki es opcional. -->
    <springProfile name="loki">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http class="com.github.loki4j.logback.ApacheHttpSender">
                <url>${LOKI_URL:-https://logs-prod-021.grafana.net/loki/api/v1/push}</url>
            </http>
            <format>
                <label>
                    <pattern>app=viscosg,instance=${HOSTNAME:-local},level=%level</pattern>
                </label>
                <message>
                    <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}","level":"%level","logger":"%logger{36}","message":"%msg","thread":"%thread"}%ex</pattern>
                </message>
                <sortByTime>true</sortByTime>
            </format>
        </appender>
    </springProfile>

    <root level="INFO">
        <springProfile name="local">
            <appender-ref ref="CONSOLE"/>
        </springProfile>
        <springProfile name="!local">
            <appender-ref ref="JSON"/>
        </springProfile>
        <springProfile name="loki">
            <appender-ref ref="LOKI"/>
        </springProfile>
    </root>
</configuration>
